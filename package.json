{
  "name": "paradar",
  "version": "1.0.0",
  "private": true,
  "description": "PAradar – identifier la plateforme agréée d'une entreprise française via Peppol",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch-path=src/server --watch-path=src/shared --env-file-if-exists=.env src/server/index.js --dev",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env src/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
