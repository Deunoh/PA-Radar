# Port du serveur Express (API)
PORT=3001

# SML Peppol utilisé par défaut : peppolprod (production) ou peppoltest (test)
DEFAULT_SML=peppolprod

# Durée de vie du cache des recherches, en minutes
CACHE_TTL_MINUTES=15

# Nombre maximum de recherches unitaires par minute et par client
RATE_LIMIT_PER_MINUTE=30

# Proxys de confiance pour l'IP du client (limite par IP) : true derrière Render, défaut loopback
# TRUST_PROXY=loopback

# Délai maximum d'un appel à l'API externe, en millisecondes
EXTERNAL_TIMEOUT_MS=10000

# URL de base de l'API Helger
HELGER_API_BASE=https://peppol.helger.com/api

# Annuaire Peppol (Peppol Directory) : découverte des inscriptions par établissement / code de routage
DIRECTORY_URL_PROD=https://directory.peppol.eu
DIRECTORY_URL_TEST=https://test-directory.peppol.eu

# --- Sources futures (non implémentées) ---
# Annuaire PPF via l'API PISTE (OAuth2 client credentials)
# PISTE_CLIENT_ID=
# PISTE_CLIENT_SECRET=
# PISTE_TOKEN_URL=https://oauth.piste.gouv.fr/api/oauth/token
# PISTE_API_BASE=
